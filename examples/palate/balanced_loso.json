{
  "training": {
    "multimodal": true,
    "balanced": true,
    "iterations": 20000,
    "device": "auto",
    "batch_size": 1024,
    "hidden_dim": 400,
    "n_layers": 2,
    "activation": "leaky_relu",
    "learning_rate": 0.0001,
    "dt": 0.1,
    "secondary_weight": 0.5,
    "matching_weight": 100.0,
    "energy_weight": 0.1,
    "manifold_weight": 0.1,
    "growth_weight": 0.0,
    "mass_weight": 1.0,
    "mass_loss": false,
    "global_mass": false,
    "sync_density_loss": true,
    "sync_pdf_loss": true,
    "map_type": "FiLMMLP",
    "seed": 0,
    "extra": {
      "adaptive_lambda": false,
      "blur_coeff": 0.1
    }
  }
}
