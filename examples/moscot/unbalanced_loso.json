{
  "training": {
    "multimodal": true,
    "balanced": false,
    "iterations": 20000,
    "device": "auto",
    "batch_size": 1024,
    "hidden_dim": 800,
    "n_layers": 3,
    "activation": "leaky_relu",
    "learning_rate": 0.0001,
    "dt": 0.1,
    "secondary_weight": 0.5,
    "matching_weight": 100.0,
    "energy_weight": 0.01,
    "manifold_weight": 0.01,
    "growth_weight": 1.0,
    "mass_weight": 1.0,
    "mass_loss": true,
    "global_mass": true,
    "sync_density_loss": true,
    "sync_pdf_loss": true,
    "map_type": "FiLMMLP",
    "seed": 0,
    "extra": {
