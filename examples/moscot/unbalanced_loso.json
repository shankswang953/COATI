      "median_n_sample": 2000,
      "floor_n_sample": 1024,
      "adaptive_lambda": true,
      "blur_coeff": 0.1,
      "pdf_coefficient_pri": 100.0,
      "pdf_coefficient_sec": 100.0,
      "lambda_max_pri": 100.0,
      "lambda_max_sec": 100.0,
      "lambda_min_pri": 10.0,
      "lambda_min_sec": 10.0,
      "floor_pri_multiplier": 2.5,
      "floor_sec_multiplier": 2.5
    }
  }
}
